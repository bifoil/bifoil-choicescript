{
  "name": "branchlight",
  "displayName": "Branchlight",
  "description": "Independent ChoiceScript authoring tools. Unaffiliated with Choice of Games or upstream ChoiceScript.",
  "version": "0.1.0",
  "publisher": "chinay",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:choicescript"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Language analysis works; game execution requires workspace trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "choicescript",
        "aliases": [
          "ChoiceScript"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "choicescript",
        "scopeName": "source.choicescript",
        "path": "./syntaxes/choicescript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "choicescript",
        "path": "./snippets.json"
      }
    ],
    "commands": [
      {
        "command": "branchlight.createProject",
        "title": "New Project",
        "category": "Branchlight"
      },
      {
        "command": "branchlight.run",
        "title": "Run Game",
        "category": "Branchlight"
      },
      {
        "command": "branchlight.stop",
        "title": "Stop Game or Tests",
        "category": "Branchlight"
      },
      {
        "command": "branchlight.quicktest",
        "title": "Run QuickTest",
        "category": "Branchlight"
      },
      {
        "command": "branchlight.randomtest",
        "title": "Run RandomTest",
        "category": "Branchlight"
      },
      {
        "command": "branchlight.exportHtml",
        "title": "Export HTML",
        "category": "Branchlight"
      },
      {
        "command": "branchlight.wordCount",
        "title": "Show Narrative Word Count",
        "category": "Branchlight"
      },
      {
        "command": "branchlight.bold",
        "title": "Bold Selection",
        "category": "Branchlight"
      },
      {
        "command": "branchlight.italic",
        "title": "Italicize Selection",
        "category": "Branchlight"
      },
      {
        "command": "branchlight.about",
        "title": "About",
        "category": "Branchlight"
      }
    ],
    "configuration": {
      "title": "Branchlight",
      "properties": {
        "branchlight.quoteWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Report inconsistent or unclosed narrative dialogue separately from expression syntax errors."
        }
      }
    },
    "configurationDefaults": {
      "[choicescript]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": false
        },
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "*.bold:choicescript": {
            "bold": true
          },
          "*.italic:choicescript": {
            "italic": true
          }
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "stringVariable",
        "description": "stringVariable in ChoiceScript",
        "superType": "variable"
      },
      {
        "id": "numberVariable",
        "description": "numberVariable in ChoiceScript",
        "superType": "variable"
      },
      {
        "id": "booleanVariable",
        "description": "booleanVariable in ChoiceScript",
        "superType": "variable"
      },
      {
        "id": "dialogue",
        "description": "dialogue in ChoiceScript",
        "superType": "string"
      },
      {
        "id": "boolean",
        "description": "boolean in ChoiceScript",
        "superType": "type"
      },
      {
        "id": "label",
        "description": "label in ChoiceScript",
        "superType": "type"
      },
      {
        "id": "narrative",
        "description": "narrative in ChoiceScript"
      },
      {
        "id": "markup",
        "description": "markup in ChoiceScript"
      },
      {
        "id": "interpolation",
        "description": "interpolation in ChoiceScript"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "bold",
        "description": "bold narrative markup"
      },
      {
        "id": "italic",
        "description": "italic narrative markup"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "choicescript",
        "scopes": {
          "stringVariable": [
            "string.quoted.double"
          ],
          "numberVariable": [
            "constant.numeric"
          ],
          "booleanVariable": [
            "constant.language.boolean"
          ],
          "boolean": [
            "constant.language.boolean"
          ],
          "dialogue": [
            "string.quoted.other.dialogue"
          ],
          "label": [
            "entity.name.function"
          ],
          "narrative": [
            "text.plain"
          ],
          "markup": [
            "punctuation.definition.tag"
          ],
          "interpolation": [
            "punctuation.section.interpolation"
          ]
        }
      }
    ]
  },
  "scripts": {
    "test:editor": "node ../../scripts/test-vscode.mjs"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Chinay-Domitrix/branchlight.git",
    "directory": "editors/vscode"
  }
}
