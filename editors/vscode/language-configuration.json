{
  "comments": {
    "lineComment": "*comment"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:\\*(?:if|elseif|elsif|else|choice|fake_choice|scene_list|stat_chart|achievement)\\b.*|#.*)$",
    "decreaseIndentPattern": "(?!)"
  }
}
