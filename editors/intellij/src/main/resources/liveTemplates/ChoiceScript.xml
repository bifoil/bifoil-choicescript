<templateSet group="ChoiceScript">
	<template
    name="csif"
    value="*if $CONDITION$&#10;  $END$&#10;*else&#10;  "
    resource-bundle="messages.BifoilBundle"
    key="live.template.csif.description"
    toReformat="false"
    toShortenFQNames="false"
  >
		<variable name="CONDITION" expression="" defaultValue="&quot;condition&quot;" alwaysStopAt="true" />
		<context>
			<option name="CHOICESCRIPT" value="true" />
		</context>
	</template>
	<template
    name="cschoice"
    value="*choice&#10;  #$OPTION$&#10;    $END$"
    resource-bundle="messages.BifoilBundle"
    key="live.template.cschoice.description"
    toReformat="false"
    toShortenFQNames="false"
  >
		<variable name="OPTION" expression="" defaultValue="&quot;Option text&quot;" alwaysStopAt="true" />
		<context>
			<option name="CHOICESCRIPT" value="true" />
		</context>
	</template>
</templateSet>
