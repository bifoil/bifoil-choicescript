<idea-plugin>
	<id>dev.bifoil.choicescript</id>
	<name>Bifoil ChoiceScript</name>
	<vendor url="https://bifoil.dev">Bifoil Foundation</vendor>
	<resource-bundle>messages.BifoilBundle</resource-bundle>
	<description>
		<![CDATA[
		<p>Write ChoiceScript games with dialogue highlighting and code navigation.</p>
		<p>Preview games, run tests, and export HTML.</p>
		<p>An unofficial Bifoil Foundation project, unaffiliated with Choice of Games or upstream ChoiceScript.</p>
		]]></description>
	<depends>com.intellij.modules.platform</depends>
	<depends>com.intellij.modules.lsp</depends>
	<extensions defaultExtensionNs="com.intellij">
		<platform.lsp.integrationProvider implementation="dev.bifoil.choicescript.ChoiceIntegration" />
		<lang.substitutor language="TEXT" implementationClass="dev.bifoil.choicescript.ChoiceSubstitutor" />
		<fileType
      name="ChoiceScript"
      implementationClass="dev.bifoil.choicescript.ChoiceFileType"
      fieldName="INSTANCE"
      language="ChoiceScript"
    />
		<lang.syntaxHighlighterFactory
      language="ChoiceScript"
      implementationClass="dev.bifoil.choicescript.ChoiceHighlighterFactory"
    />
		<colorSettingsPage implementation="dev.bifoil.choicescript.ChoiceColorsPage" />
		<lang.parserDefinition language="ChoiceScript" implementationClass="dev.bifoil.choicescript.ChoiceParserDefinition" />
		<lang.commenter language="ChoiceScript" implementationClass="dev.bifoil.choicescript.ChoiceCommenter" />
		<enterHandlerDelegate implementation="dev.bifoil.choicescript.ChoiceEnterHandler" />
		<liveTemplateContext contextId="CHOICESCRIPT" implementation="dev.bifoil.choicescript.ChoiceTemplateContext" />
		<defaultLiveTemplates file="/liveTemplates/ChoiceScript" />
		<toolWindow id="Bifoil ChoiceScript" anchor="bottom" factoryClass="dev.bifoil.choicescript.ChoiceToolWindow" />
	</extensions>
	<actions>
		<group id="BifoilChoiceScript.Actions" popup="true">
			<add-to-group group-id="ToolsMenu" anchor="last" />
			<action id="BifoilChoiceScript.New" class="dev.bifoil.choicescript.NewProjectAction" />
			<action id="BifoilChoiceScript.Run" class="dev.bifoil.choicescript.RunAction" />
			<action id="BifoilChoiceScript.Stop" class="dev.bifoil.choicescript.StopAction" />
			<action id="BifoilChoiceScript.QuickTest" class="dev.bifoil.choicescript.QuickTestAction" />
			<action id="BifoilChoiceScript.RandomTest" class="dev.bifoil.choicescript.RandomTestAction" />
			<action id="BifoilChoiceScript.Export" class="dev.bifoil.choicescript.ExportAction" />
			<action id="BifoilChoiceScript.Words" class="dev.bifoil.choicescript.WordCountAction" />
			<action id="BifoilChoiceScript.Bold" class="dev.bifoil.choicescript.BoldAction" />
			<action id="BifoilChoiceScript.Italic" class="dev.bifoil.choicescript.ItalicAction" />
			<action id="BifoilChoiceScript.QuoteWarnings" class="dev.bifoil.choicescript.QuoteWarningsAction" />
			<action id="BifoilChoiceScript.About" class="dev.bifoil.choicescript.AboutAction" />
		</group>
	</actions>
</idea-plugin>
