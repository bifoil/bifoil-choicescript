{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023"]
  },
  "include": ["packages/**/*.ts", "editors/vscode/src/**/*.ts"]
}
