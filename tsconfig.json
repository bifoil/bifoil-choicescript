{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "editors/vscode/src/**/*.ts"
  ]
}
